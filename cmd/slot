#!/usr/bin/env bash
# desc: deprecated: use `factory run` (slot status = run --status; slot wait = run --wait --job build)
# usage: factory slot status            -> factory run --status
#        factory slot wait [--timeout <s>] -> factory run --wait --job build [--timeout <s>]
# Kept for scripts written before v0.22.0. --dd, --udid and --ignore-leftovers are accepted and ignored: `factory run`
# weighs jobs against [slot] capacity and no longer counts derived-data folders or booted simulators. Inside a
# `factory run` lease, `slot wait` says go at once.
set -euo pipefail
: "${FK_KIT_DIR:?run this through bin/factory}"

SUB="${1:-}"; shift || true
TIMEOUT=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dd|--udid) shift 2 ;;
    --ignore-leftovers) shift ;;
    --timeout) TIMEOUT=(--timeout "${2:?}"); shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
done
case "$SUB" in
  status) echo "factory slot is deprecated: use factory run --status" >&2
          exec node "$FK_KIT_DIR/cmd/run.mjs" --status ;;
  wait)   echo "factory slot is deprecated: run the job itself with factory run --job <type> -- <cmd>" >&2
          exec node "$FK_KIT_DIR/cmd/run.mjs" --wait --job build ${TIMEOUT[@]+"${TIMEOUT[@]}"} ;;
  *) echo "usage: factory slot status | factory slot wait [--timeout <s>]  (deprecated: use factory run)" >&2; exit 1 ;;
esac
