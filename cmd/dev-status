#!/usr/bin/env bash
# desc: show which dev-stack ports are up, down or hung
# usage: factory dev-status
# One line per [dev] all_ports entry (or the wait_ports when all_ports is not set): ":PORT up", ":PORT down",
# or, with [dev] probe = "http", ":PORT hung" (it accepts connections but never answers: `factory dev-restart`).
# Exit 0 when every [dev] wait_ports entry is up, 1 when any is down or hung, 2 when no ports are configured.
set -euo pipefail
. "${FK_KIT_DIR:?run this through bin/factory}/lib/sh/common.sh"

ALL="${FK_DEV_ALL_PORTS:-${FK_DEV_WAIT_PORTS:-}}"
[[ -n "$ALL" ]] || { echo "factory dev-status: [dev] all_ports and wait_ports are not set" >&2; exit 2; }

STATE=""
while IFS= read -r p; do
  [[ -n "$p" ]] || continue
  s="$(fk_port_state "$p")"
  echo ":$p $s"
  STATE="$STATE $p=$s"
done <<< "$ALL"

RC=0
while IFS= read -r p; do
  [[ -n "$p" ]] || continue
  if [[ "$STATE " == *" $p=up "* ]]; then continue; fi
  # a wait port that is not in all_ports still has to be up
  if [[ "$STATE " == *" $p=down "* || "$STATE " == *" $p=hung "* ]] || [[ "$(fk_port_state "$p")" != up ]]; then RC=1; fi
done <<< "${FK_DEV_WAIT_PORTS:-}"
exit "$RC"
